{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/src/rules.rs",
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-floating-promises": "warn",
    "eqeqeq": "error",
    "no-console": "warn",
    "prefer-const": "error"
  },
  "env": {
    "node": true
  }
}
